# SentryVault Core Banking Solution - Environment Configuration

PROJECT_NAME="SentryVault Bank"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="super-secret-production-key-securebank-2026-change-in-prod-123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OPTION 1: SQLite Embedded (Default / Local Dev) ---
DATABASE_URL="sqlite:///./securebank.db"

# --- OPTION 2: External Database Server (Separate VM in Internal Network) ---
# Uncomment and set your Internal Network Database VM details:
# DB_HOST=192.168.1.105
# DB_PORT=3306
# DB_USER=sentryuser
# DB_PASSWORD=SecureDbPassword123!
# DB_NAME=sentryvault
# Or set complete connection string directly:
# DATABASE_URL="mysql+pymysql://sentryuser:SecureDbPassword123!@192.168.1.105:3306/sentryvault"

# Logging & WAF/SIEM Telemetry
LOG_FILE_PATH="/app/logs/application.log"
LOG_LEVEL="INFO"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80","http://192.168.1.100"]

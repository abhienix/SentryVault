# Environment File for Debian DMZ Host VM
# Place in /etc/sentryvault/backend.env on Debian VM

PROJECT_NAME="SentryVault Bank"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-production-key-securebank-2026-change-in-prod-123456789"
ALGORITHM="HS256"

# Internal MySQL Database Server (Ubuntu Internal VM e.g. 192.168.20.100)
DB_HOST="192.168.20.100"
DB_PORT="3306"
DB_USER="sentryuser"
DB_PASSWORD="SecureDbPassword123!"
DB_NAME="sentryvault"
DATABASE_URL="mysql+pymysql://sentryuser:SecureDbPassword123!@192.168.20.100:3306/sentryvault"

# Logging location for Wazuh Agent tailing in DMZ
LOG_FILE_PATH="/var/log/sentryvault/application.log"
LOG_LEVEL="INFO"

# Allowed CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost","http://192.168.10.10","http://127.0.0.1"]

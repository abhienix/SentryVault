# Environment File for Ubuntu Backend VM
# Place in /etc/sentryvault/backend.env on Ubuntu VM

PROJECT_NAME="SentryVault Bank"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-production-key-securebank-2026-change-in-prod-123456789"
ALGORITHM="HS256"

# Database Server VM in Internal Network (e.g. 192.168.20.50)
DB_HOST="192.168.20.50"
DB_PORT="3306"
DB_USER="sentryuser"
DB_PASSWORD="SecureDbPassword123!"
DB_NAME="sentryvault"
DATABASE_URL="mysql+pymysql://sentryuser:SecureDbPassword123!@192.168.20.50:3306/sentryvault"

# Logging location for Wazuh Agent tailing
LOG_FILE_PATH="/var/log/sentryvault/application.log"
LOG_LEVEL="INFO"

# Allowed CORS Origins (Debian Frontend VM IP e.g. 192.168.10.10)
BACKEND_CORS_ORIGINS=["http://192.168.10.10","http://localhost","http://192.168.10.20"]

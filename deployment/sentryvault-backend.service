[Unit]
Description=SentryVault Core Banking FastAPI Backend Service
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/sentryvault/backend
Environment="PATH=/opt/sentryvault/backend/venv/bin"
EnvironmentFile=/etc/sentryvault/backend.env
ExecStart=/opt/sentryvault/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4

Restart=always
RestartSec=5
StandardOutput=append:/var/log/sentryvault/application.log
StandardError=append:/var/log/sentryvault/application.log

[Install]
WantedBy=multi-user.target

# Application Settings
PROJECT_NAME="SecureBank Portal"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (MySQL)
DATABASE_URL="mysql+pymysql://securebank_user:securebank_password@localhost:3306/securebank_db"

# Security & JWT Auth
SECRET_KEY="super-secret-production-key-securebank-2026-change-in-prod-123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sentry Vulnerability Demo Mode Flag
# Set to 'true' to activate /demo/* endpoints for SQLi, XSS, Brute Force, and Path Traversal testing.
# Set to 'false' to disable and return HTTP 404 for all /demo/* routes.
DEMO_MODE=true

# Application Logging (Targeted for Wazuh Log Collector)
LOG_FILE_PATH="/app/logs/application.log"
LOG_LEVEL="INFO"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost"
